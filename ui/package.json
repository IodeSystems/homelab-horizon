{
  "name": "homelab-horizon-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "pnpm run test:logic && pnpm run test:render && pnpm run test:model && pnpm run test:model-render && pnpm run test:routes && pnpm run test:routes-render && pnpm run test:edge && pnpm run test:health && pnpm run test:hosts && pnpm run test:hosts-render && pnpm run test:assign && pnpm run test:assign-render && pnpm run test:overview && pnpm run test:overview-render && pnpm run test:segments-render && pnpm run test:bans-render && pnpm run test:checks-render && pnpm run test:vpn-render && pnpm run test:ports-render && pnpm run test:machines-render && pnpm run test:instances-render",
    "test:logic": "node src/components/drift/observation.selftest.ts",
    "test:render": "vite build --ssr src/components/drift/render.selftest.tsx --outDir .rendercheck --logLevel warn && node .rendercheck/render.selftest.js",
    "test:model": "node src/components/model/model.selftest.ts",
    "test:model-render": "vite build --ssr src/components/model/model.render.selftest.tsx --outDir .rendercheck-model --logLevel warn && node .rendercheck-model/model.render.selftest.js",
    "test:routes": "node src/components/model/projectRoutes.selftest.ts",
    "test:routes-render": "vite build --ssr src/components/model/projectRoutes.render.selftest.tsx --outDir .rendercheck-routes --logLevel warn && node .rendercheck-routes/projectRoutes.render.selftest.js",
    "test:edge": "vite build --ssr src/components/EdgeDiagnosis.selftest.tsx --outDir .rendercheck-edge --logLevel warn && node .rendercheck-edge/EdgeDiagnosis.selftest.js",
    "test:health": "vite build --ssr src/components/SystemHealthTab.selftest.tsx --outDir .rendercheck-health --logLevel warn && node .rendercheck-health/SystemHealthTab.selftest.js",
    "test:hosts": "node src/components/hosts/hosts.selftest.ts",
    "test:hosts-render": "vite build --ssr src/components/hosts/hosts.render.selftest.tsx --outDir .rendercheck-hosts --logLevel warn && node .rendercheck-hosts/hosts.render.selftest.js",
    "test:assign": "node src/components/model/assign.selftest.ts",
    "test:assign-render": "vite build --ssr src/components/model/assign.render.selftest.tsx --outDir .rendercheck-assign --logLevel warn && node .rendercheck-assign/assign.render.selftest.js",
    "test:overview": "node src/components/overview/queue.selftest.ts",
    "test:overview-render": "vite build --ssr src/components/overview/overview.render.selftest.tsx --outDir .rendercheck-overview --logLevel warn && node .rendercheck-overview/overview.render.selftest.js",
    "test:segments-render": "vite build --ssr src/components/model/SegmentDialogs.render.selftest.tsx --outDir .rendercheck-segments --logLevel warn && node .rendercheck-segments/SegmentDialogs.render.selftest.js",
    "test:bans-render": "vite build --ssr src/components/bans.render.selftest.tsx --outDir .rendercheck-bans --logLevel warn && node .rendercheck-bans/bans.render.selftest.js",
    "test:checks-render": "vite build --ssr src/components/checks.render.selftest.tsx --outDir .rendercheck-checks --logLevel warn && node .rendercheck-checks/checks.render.selftest.js",
    "test:vpn-render": "vite build --ssr src/components/vpn.render.selftest.tsx --outDir .rendercheck-vpn --logLevel warn && node .rendercheck-vpn/vpn.render.selftest.js",
    "test:ports-render": "vite build --ssr src/components/ports.render.selftest.tsx --outDir .rendercheck-ports --logLevel warn && node .rendercheck-ports/ports.render.selftest.js",
    "test:machines-render": "vite build --ssr src/components/machines.render.selftest.tsx --outDir .rendercheck-machines --logLevel warn && node .rendercheck-machines/machines.render.selftest.js",
    "test:instances-render": "vite build --ssr src/components/instances.render.selftest.tsx --outDir .rendercheck-instances --logLevel warn && node .rendercheck-instances/instances.render.selftest.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.18",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}

.idea
.claude
dist
# Built binaries, anchored to the repo root. Unanchored, "homelab-horizon" also
# matched the SOURCE directory cmd/homelab-horizon/, so every new file added
# there was silently untracked — which is exactly how root.go reached CI as an
# undefined symbol while building fine locally.
/homelab-horizon
/hz
/hz-probe
/hz-agent
coverage.out
coverage.html
deploy.sh
ui/node_modules
ui/dist
ui/*.tsbuildinfo
# `pnpm test:render` / `test:model-render` bundle the render checks here
# before running them.
ui/.rendercheck
ui/.rendercheck-model
ui/.rendercheck-edge
ui/.rendercheck-health
ui/.rendercheck-hosts
ui/.rendercheck-routes
ui/.rendercheck-assign
ui/.rendercheck-overview
ui/.rendercheck-segments
ui/.rendercheck-ports
docs/node_modules
docs/package-lock.json
homelab-horizon-linux
.hz.json

# Secrets (CFG-4) — never commit. hz's runtime config holds DNS creds + tokens
# and lives on the box (/etc/homelab-horizon/config.json), not in the repo.
# The tracked templates are docker/demo-config.json + the `-config-template` flag.
/config.json
/homelab-horizon.json
*.token
secrets.env
*.secret
*.secret.*
*.secret.properties

# Generated doc-deploy integration (contains a service token)
bin/deploy-doc

# Cross-compiled hz binaries embedded into the server (make hz-embed)
internal/server/hzbin/bin/
internal/server/uiembed/dist/

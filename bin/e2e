#!/usr/bin/env bash
# End-to-end test of the VPN MFA jail against a real kernel.
#
# Boots a throwaway multipass VM, installs hz plus WireGuard/HAProxy, builds a
# peer + a stand-in LAN host as network namespaces, and asserts what a VPN peer
# can actually reach — jailed, verified, and as an admin.
#
# Multipass rather than Docker because hz drives systemd: `systemctl` for
# HAProxy lifecycle and `systemd-run` for its iptables calls. A container has
# no PID 1 systemd, so those paths — the ones this test exists to cover —
# can't run there at all.
#
# Usage: ./bin/e2e
#
# Env overrides:
#   VM      VM name (default hz-e2e)
#   IMAGE   multipass image (default lts)
#   KEEP    set to 1 to leave the VM running for debugging
#   REUSE   set to 1 to skip launch+provision and re-run assertions only
#           (needs a VM left behind by KEEP=1)
#
#   METRICS set to 1 to also run the metrics integration checks
#           (test/e2e/metrics.sh). Installs real dnsmasq and node-exporter and
#           verifies hz reads and merges them — the format risk unit tests
#           cannot cover. Leaves the VM with both installed.
#
#   ACCOUNT set to 1 to also run the admin ACCOUNT auth checks
#           (test/e2e/account.sh): bootstrap, password login, TOTP enrolment
#           against oathtool, the second-factor gate, and the guards that stop
#           an operator locking themselves out. Resets the identity store, so
#           it leaves the VM with one account (carl) and the token re-enabled.
#
#   ACCOUNT_PASSKEY
#           set to 1 to also drive a passkey ceremony for an admin ACCOUNT
#           (test/e2e/account-passkey.sh). Needs https and an admin_url, so it
#           reconfigures the VM the same way PASSKEY does and leaves it there.
#           Implies the browser download. This is the second relying party --
#           account passkeys are scoped to admin_url, not kiosk_url.
#
#   OIDC    set to 1 to also run the single-sign-on flow (test/e2e/oidc.sh)
#           against a stub provider served by test/e2e/oidc-idp.mjs. The
#           provider is stubbed but the protocol is not: real discovery, real
#           JWKS, real RS256 verification, and the stub checks hz's PKCE
#           verifier. Needs https, so it reconfigures the VM and leaves it
#           there.
#
#   PASSKEY set to 1 to also run the WebAuthn ceremony (test/e2e/passkey.sh).
#           Reconfigures the VM onto https with a self-signed cert and drives
#           a virtual authenticator, so it runs after the main assertions and
#           leaves the VM on that https deployment. Needs a ~150MB Playwright
#           chromium download inside the VM on first run.
#
#   BRIDGED set to 1 to put the VM on your LAN instead of multipass's
#           host-local NAT network. Only needed to reach the VM from another
#           machine — e.g. pasting a peer config into WireGuard on a laptop to
#           click through the captive portal by hand. The test itself never
#           needs it: the peer is a network namespace inside the VM.
#   BRIDGE_IFACE
#           host interface to bridge onto (e.g. enp5s0). Preferred over the
#           global setting — see the warnings in require_bridge below.

set -euo pipefail

cd "$(dirname "$0")/.."

readonly VM="${VM:-hz-e2e}"
readonly IMAGE="${IMAGE:-lts}"
readonly BIN=dist/homelab-horizon-linux-amd64
readonly FIXTURE=test/e2e

err()  { printf >&2 "e2e: %s\n" "$*"; exit 1; }
note() { printf "e2e: %s\n" "$*"; }

command -v multipass >/dev/null 2>&1 || err "multipass not installed"
[ -d "$FIXTURE" ] || err "missing $FIXTURE (run from repo root)"

# require_bridge resolves how to launch a LAN-reachable VM, echoing the launch
# flags. Deliberately noisy: both routes have consequences outside this script.
#
#   BRIDGE_IFACE=<iface>  ->  --network <iface>, no persistent state anywhere.
#   otherwise             ->  --bridged, which needs multipass's GLOBAL
#                             local.bridged-network setting.
#
# That setting is per-host, not per-instance. Once set it silently governs
# every `--bridged` launch by every multipass user on this machine, for any
# project, until someone unsets it — so it is not something this script will
# set on your behalf.
require_bridge() {
  if [ -n "${BRIDGE_IFACE:-}" ]; then
    note "bridging onto $BRIDGE_IFACE via --network (no global multipass state touched)"
    printf -- '--network %s' "$BRIDGE_IFACE"
    return 0
  fi

  local configured
  configured=$(multipass get local.bridged-network 2>/dev/null || true)
  if [ -z "$configured" ] || [ "$configured" = "<empty>" ]; then
    cat >&2 <<'MSG'
e2e: BRIDGED=1 needs a bridge, and none is configured.

  Preferred — scoped to this run, leaves no global state:

      BRIDGE_IFACE=<iface> BRIDGED=1 ./bin/e2e

  Or set multipass's global default, which this script will NOT do for you:

      multipass set local.bridged-network=<iface>

  Two things to know before doing that:

  * It is GLOBAL and persistent. Every `--bridged` multipass launch on this
    host picks it up afterwards — other projects, other people's VMs, not
    just hz demos — until someone runs `multipass set local.bridged-network=`.

  * Bridging a physical interface makes the network stack enslave it to a new
    bridge. On a NetworkManager host that briefly drops the link and anything
    riding on it (docker networks, existing SSH sessions). Do not do it on a
    machine you are administering remotely without a way back in.

  Neither is needed for the test itself — only to reach the VM from another
  machine.
MSG
    exit 1
  fi

  note "bridging via multipass's global local.bridged-network=$configured"
  note "  (global setting — it affects every --bridged launch on this host)"
  printf -- '--bridged'
}

cleanup() {
  local rc=$?
  if [ "${KEEP:-0}" = "1" ]; then
    note "KEEP=1 — leaving $VM running (multipass shell $VM; REUSE=1 ./bin/e2e to re-assert)"
  else
    note "deleting $VM..."
    multipass delete --purge "$VM" >/dev/null 2>&1 || true
  fi
  return $rc
}

if [ "${REUSE:-0}" != "1" ]; then
  # Resolve the bridge before doing any work — failing after a full UI build
  # is just a slower way to say the same thing.
  bridge_args=""
  [ "${BRIDGED:-0}" = "1" ] && bridge_args=$(require_bridge)

  note "building linux/amd64 binary..."
  make build-linux-amd64 >/dev/null || err "build failed"
  [ -f "$BIN" ] || err "expected $BIN after build"

  # A stale VM from an interrupted run would silently reuse its old state.
  multipass delete --purge "$VM" >/dev/null 2>&1 || true

  note "launching $VM ($IMAGE)... this takes a minute"
  # shellcheck disable=SC2086 # bridge_args is a deliberate word-split flag pair
  multipass launch "$IMAGE" --name "$VM" --cpus 2 --memory 2G --disk 8G $bridge_args \
    || err "multipass launch failed"
  trap cleanup EXIT

  note "transferring binary + fixture..."
  multipass transfer "$BIN" "$VM:/home/ubuntu/homelab-horizon"
  multipass transfer "$FIXTURE/config.json" "$VM:/home/ubuntu/e2e-config.json"
  multipass transfer "$FIXTURE/provision.sh" "$VM:/home/ubuntu/provision.sh"
  multipass transfer "$FIXTURE/assert.sh" "$VM:/home/ubuntu/assert.sh"
  multipass exec "$VM" -- sudo install -m 0755 /home/ubuntu/homelab-horizon /usr/local/bin/homelab-horizon
  multipass exec "$VM" -- chmod +x /home/ubuntu/provision.sh /home/ubuntu/assert.sh

  note "provisioning..."
  multipass exec "$VM" -- sudo /home/ubuntu/provision.sh || err "provisioning failed"
else
  trap cleanup EXIT
  note "REUSE=1 — re-running assertions against the existing $VM"
  multipass transfer "$FIXTURE/assert.sh" "$VM:/home/ubuntu/assert.sh"
  multipass exec "$VM" -- chmod +x /home/ubuntu/assert.sh
fi

note "asserting..."
if multipass exec "$VM" -- sudo /home/ubuntu/assert.sh; then
  if [ "${METRICS:-0}" = "1" ]; then
    note "running the metrics integration checks (real dnsmasq + node-exporter)..."
    multipass transfer "$FIXTURE/metrics.sh" "$VM:/home/ubuntu/metrics.sh"
    multipass exec "$VM" -- sudo bash /home/ubuntu/metrics.sh || err "metrics checks failed"
  fi
  if [ "${ACCOUNT:-0}" = "1" ]; then
    note "running the admin account auth checks (bootstrap, TOTP, lockout guards)..."
    multipass transfer "$FIXTURE/account.sh" "$VM:/home/ubuntu/account.sh"
    multipass exec "$VM" -- sudo bash /home/ubuntu/account.sh || err "account checks failed"
  fi
  if [ "${ACCOUNT_PASSKEY:-0}" = "1" ]; then
    note "running the account passkey ceremony (https admin_url + virtual authenticator)..."
    multipass transfer "$FIXTURE/install-browser.sh" "$VM:/home/ubuntu/install-browser.sh"
    multipass transfer "$FIXTURE/account-passkey.mjs" "$VM:/home/ubuntu/account-passkey.mjs"
    multipass transfer "$FIXTURE/account-passkey.sh" "$VM:/home/ubuntu/account-passkey.sh"
    multipass exec "$VM" -- sudo bash /home/ubuntu/install-browser.sh
    multipass exec "$VM" -- sudo bash /home/ubuntu/account-passkey.sh || err "account passkey flow failed"
  fi
  if [ "${OIDC:-0}" = "1" ]; then
    note "running the single sign-on flow (stub provider, real protocol)..."
    multipass transfer "$FIXTURE/oidc-idp.mjs" "$VM:/home/ubuntu/oidc-idp.mjs"
    multipass transfer "$FIXTURE/oidc.sh" "$VM:/home/ubuntu/oidc.sh"
    multipass exec "$VM" -- sudo bash /home/ubuntu/oidc.sh || err "oidc flow failed"
  fi
  if [ "${PASSKEY:-0}" = "1" ]; then
    note "running the passkey ceremony (https + virtual authenticator)..."
    multipass transfer "$FIXTURE/install-browser.sh" "$VM:/home/ubuntu/install-browser.sh"
    multipass transfer "$FIXTURE/passkey.mjs" "$VM:/home/ubuntu/passkey.mjs"
    multipass transfer "$FIXTURE/passkey.sh" "$VM:/home/ubuntu/passkey.sh"
    multipass exec "$VM" -- sudo bash /home/ubuntu/install-browser.sh
    multipass exec "$VM" -- sudo bash /home/ubuntu/passkey.sh || err "passkey flow failed"
  fi
  note "PASS"
  if [ "${BRIDGED:-0}" = "1" ]; then
    note "VM addresses (the LAN one is your WireGuard Endpoint host):"
    multipass info "$VM" | sed -n '/IPv4/,/^[A-Z]/p' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sed 's/^/  /'
  fi
else
  note "FAIL — hz log follows"
  multipass exec "$VM" -- sudo tail -40 /var/log/hz.log 2>/dev/null || true
  exit 1
fi
